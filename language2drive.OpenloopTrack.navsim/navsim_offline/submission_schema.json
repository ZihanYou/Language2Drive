{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L2D Offline NAVSIM prediction submission",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["0", "1"],
    "additionalProperties": false,
    "properties": {
      "0": {"$ref": "#/$defs/trajectory"},
      "1": {"$ref": "#/$defs/trajectory"}
    }
  },
  "$defs": {
    "trajectory": {
      "type": "object",
      "required": ["coordinate_frame", "reference_point", "timestamps", "positions_xy"],
      "additionalProperties": false,
      "properties": {
        "coordinate_frame": {"const": "ego_at_anchor"},
        "reference_point": {"const": "rear_axle"},
        "timestamps": {"const": [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0]},
        "positions_xy": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "number"}
          }
        },
        "headings": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"type": "number"}
        }
      }
    }
  }
}
